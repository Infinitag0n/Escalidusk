# Copy to .env and fill in. Then: docker compose up -d --build

# The port it is reached on, on this machine.
PORT=3000

# Where the app lives. Empty for the root of the host, or a path such as /draw.
BASE_PATH=

# A thin yellow notice across the top of every page, such as
# "Experimental build 2026-11-18". Leave empty for none. Takes a restart only.
BANNER=

# Backoffice at <url>/admin. Leave empty and it does not exist.
ADMIN_PASSWORD=

# The most the database may grow to, such as 5GB. From 90% of it, new diagrams
# and images are turned away; at it, nothing more is saved. Leave empty for
# no limit. Keep it well under the size of the disk: logs and the rest of the
# system live there too.
MAX_DATABASE_SIZE=

# true to log every request, for tracking something down. Otherwise only
# starting, warnings and failures are logged.
LOG_REQUESTS=false

# true when a reverse proxy (nginx, oauth2-proxy) sits in front.
TRUST_PROXY=false

# --- Entra ID sign-in (optional; see README, "Sign in with Entra ID") ---
# To use it, uncomment everything below.

# COMPOSE_FILE=docker-compose.yml:docker-compose.entra.yml
# COMPOSE_PATH_SEPARATOR=:
# PUBLIC_URL=https://example.com/draw
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Generate with: openssl rand -hex 16
# OAUTH2_PROXY_COOKIE_SECRET=
