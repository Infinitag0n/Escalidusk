# Copy to .env and fill in. Then: docker compose up -d --build

# Where the app lives. Empty for the root of the host, or a path such as /draw.
BASE_PATH=

# Backoffice at <url>/admin. Leave empty to switch it off.
ADMIN_PASSWORD=

# true when a reverse proxy (nginx, oauth2-proxy) sits in front.
TRUST_PROXY=false

# --- Entra ID sign-in (optional; see README, "Sign in with Entra ID") ---
# To use it, uncomment everything below.

# COMPOSE_FILE=docker-compose.yml:docker-compose.entra.yml
# PUBLIC_URL=https://example.com/draw
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Generate with: openssl rand -hex 16
# OAUTH2_PROXY_COOKIE_SECRET=
